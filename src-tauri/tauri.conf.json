{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dropzone",
  "version": "0.2.0",
  "identifier": "com.moab.dropzone",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dropzone",
        "width": 340,
        "height": 396,
        "resizable": false,
        "decorations": false,
        "skipTaskbar": false,
        "alwaysOnTop": true,
        "maximizable": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "plugins": {
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Dropzone",
    "publisher": "Datasoft",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
